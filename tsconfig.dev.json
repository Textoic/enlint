{
  // Everything that runs on Node at development time: the test suite and the
  // scripts that build the docs. Unlike the library itself, this code is
  // allowed to touch the filesystem.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true
  },
  "references": [{ "path": "./tsconfig.src.json" }],
  "include": ["scripts/**/*.ts", "test/**/*.ts"]
}
